# 必填：推荐只填写 token，由程序自动拼接默认 WebSocket 地址
XIAOZHI_TOKEN=your_xiaozhi_token_here

# 可选：如果你已经拿到了完整的 WebSocket 地址，可以直接填这里
# XIAOZHI_ENDPOINT_URL=wss://api.xiaozhi.me/mcp/?token=your_token_here

# 可选：覆盖默认地址
# XIAOZHI_WS_BASE_URL=wss://api.xiaozhi.me/mcp/

# 本地 MCP Streamable HTTP 服务地址
MCP_HTTP_URL=http://127.0.0.1:8000/mcp

# FastAPI 对外监听地址（避免与本地 MCP 服务端口冲突）
APP_HOST=127.0.0.1
APP_PORT=8765

# 日志与连接参数
LOG_LEVEL=INFO
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=20
RECONNECT_MAX_BACKOFF=60
CONNECT_TIMEOUT=30
MAX_LOG_CHARS=500

